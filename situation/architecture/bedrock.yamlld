# Bedrock's own identity vertex (SPINE §5 register item 1: the architecture
# vertex marked role: identity). `role: identity` marks this as the source of
# the generated AGENTS.md title line. `path` edges feed the "Where things
# live" register item — only paths that exist this epoch are listed (src/,
# tests/, AGENTS.md land with W1/W4 and re-situate the register then).
"@context": "https://yeetz.dev/bedrock/context/v1"
"@id": "https://yeetz.dev/bedrock/vertex/bedrock"
"@type": "https://yeetz.dev/bedrock/ontology/Identity"
label: "bedrock"
role: "identity"
statement: >
  bedrock is a single Rust binary (crate yeetz-bedrock) that seeds a repo with a
  YAML-LD situation, checks the situation, and compiles it into one generated
  AGENTS.md register plus a deterministic TriG graph.
path:
  - "https://yeetz.dev/bedrock/path/spec"
  - "https://yeetz.dev/bedrock/path/seed"
  - "https://yeetz.dev/bedrock/path/situation"
