{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yeetz.dev/bedrock/schema/architecture/v1",
  "title": "Bedrock architecture namespace vertex schema",
  "description": "What this repo is / intends (SPINE §4 C4 minimum-vertex rule). Validates every situation/architecture/*.yamlld vertex.",
  "type": "object",
  "additionalProperties": false,
  "required": ["@context", "@id", "@type"],
  "properties": {
    "@context": { "const": "https://yeetz.dev/bedrock/context/v1" },
    "@id": { "$ref": "#/$defs/vertexId" },
    "@type": { "$ref": "#/$defs/type" },
    "label": { "$ref": "#/$defs/label" },
    "statement": { "$ref": "#/$defs/boundedText" },
    "role": { "type": "string", "minLength": 1, "maxLength": 60 },
    "requires": { "$ref": "#/$defs/vertexPointer" },
    "references": { "$ref": "#/$defs/vertexPointerList" },
    "consumes": { "$ref": "#/$defs/pointerList" },
    "produces": { "$ref": "#/$defs/pathPointerList" },
    "member-of": { "$ref": "#/$defs/vertexPointer" },
    "source": { "$ref": "#/$defs/pathPointer" },
    "path": { "$ref": "#/$defs/pathPointerList" }
  },
  "minProperties": 3,
  "allOf": [
    {
      "if": { "properties": { "@type": { "const": "https://yeetz.dev/bedrock/ontology/Identity" } }, "required": ["@type"] },
      "then": { "required": ["statement", "role"] }
    },
    {
      "if": { "properties": { "@type": { "const": "https://yeetz.dev/bedrock/ontology/SituationStructure" } }, "required": ["@type"] },
      "then": { "required": ["statement"] }
    }
  ],
  "anyOf": [{ "required": ["label"] }, { "required": ["statement"] }],
  "$defs": {
    "vertexId": { "type": "string", "pattern": "^https://yeetz\\.dev/bedrock/vertex/[a-z0-9][a-z0-9-]*$" },
    "label": { "type": "string", "minLength": 1, "maxLength": 120 },
    "boundedText": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "pathPointer": { "type": "string", "pattern": "^https://yeetz\\.dev/bedrock/path/[A-Za-z0-9._/\\-]+$" },
    "vertexPointer": { "type": "string", "pattern": "^https://yeetz\\.dev/bedrock/vertex/[a-z0-9][a-z0-9-]*$" },
    "vertexPointerList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/vertexPointer" } },
    "pointer": { "type": "string", "pattern": "^https://yeetz\\.dev/bedrock/(vertex|path)/[A-Za-z0-9._/\\-]+$" },
    "pointerList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/pointer" } },
    "pathPointerList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/pathPointer" } },
    "type": {
      "type": "string",
      "enum": [
        "https://yeetz.dev/bedrock/ontology/Identity",
        "https://yeetz.dev/bedrock/ontology/SituationStructure"
      ]
    }
  }
}
