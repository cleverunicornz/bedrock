{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yeetz.dev/bedrock/schema/record/v1",
  "title": "Bedrock record namespace vertex schema",
  "description": "Epoch records, deploy placements, and reflect verdicts (SPINE §4 C4 minimum-vertex rule). The EpochRecord shape models SPINE §6: commit SHA of the cut, bedrock version (+ optional --offline stamp), mode, and a one-line statement. Validates every situation/record/*.yamlld vertex.",
  "type": "object",
  "additionalProperties": false,
  "required": ["@context", "@id", "@type"],
  "properties": {
    "@context": { "const": "https://yeetz.dev/bedrock/context/v1" },
    "@id": { "$ref": "#/$defs/vertexId" },
    "@type": { "$ref": "#/$defs/type" },
    "label": { "$ref": "#/$defs/label" },
    "statement": { "$ref": "#/$defs/boundedText" },
    "commit": { "$ref": "#/$defs/gitCommit" },
    "version": { "$ref": "#/$defs/version" },
    "offline": { "type": "boolean", "$comment": "true stamps that --offline was used (SPINE §1 / §6 version gate)" },
    "mode": { "enum": ["init", "adopt"] },
    "requires": { "$ref": "#/$defs/vertexPointer" },
    "references": { "$ref": "#/$defs/vertexPointerList" },
    "consumes": { "$ref": "#/$defs/pointerList" },
    "produces": { "$ref": "#/$defs/pathPointerList" },
    "member-of": { "$ref": "#/$defs/vertexPointer" },
    "source": { "$ref": "#/$defs/pathPointer" },
    "path": { "$ref": "#/$defs/pathPointerList" }
  },
  "minProperties": 3,
  "allOf": [
    {
      "if": { "properties": { "@type": { "const": "https://yeetz.dev/bedrock/ontology/EpochRecord" } }, "required": ["@type"] },
      "then": { "required": ["commit", "version", "mode", "statement"] }
    },
    {
      "if": { "properties": { "@type": { "const": "https://yeetz.dev/bedrock/ontology/DeployPlacement" } }, "required": ["@type"] },
      "then": { "anyOf": [{ "required": ["label"] }, { "required": ["statement"] }] }
    },
    {
      "if": { "properties": { "@type": { "const": "https://yeetz.dev/bedrock/ontology/ReflectVerdict" } }, "required": ["@type"] },
      "then": { "anyOf": [{ "required": ["label"] }, { "required": ["statement"] }] }
    }
  ],
  "anyOf": [{ "required": ["label"] }, { "required": ["statement"] }],
  "$defs": {
    "vertexId": { "type": "string", "pattern": "^https://yeetz\\.dev/bedrock/vertex/[a-z0-9][a-z0-9-]*$" },
    "label": { "type": "string", "minLength": 1, "maxLength": 120 },
    "boundedText": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$" },
    "pathPointer": { "type": "string", "pattern": "^https://yeetz\\.dev/bedrock/path/[A-Za-z0-9._/\\-]+$" },
    "vertexPointer": { "type": "string", "pattern": "^https://yeetz\\.dev/bedrock/vertex/[a-z0-9][a-z0-9-]*$" },
    "vertexPointerList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/vertexPointer" } },
    "pointer": { "type": "string", "pattern": "^https://yeetz\\.dev/bedrock/(vertex|path)/[A-Za-z0-9._/\\-]+$" },
    "pointerList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/pointer" } },
    "pathPointerList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/pathPointer" } },
    "type": {
      "type": "string",
      "enum": [
        "https://yeetz.dev/bedrock/ontology/EpochRecord",
        "https://yeetz.dev/bedrock/ontology/DeployPlacement",
        "https://yeetz.dev/bedrock/ontology/ReflectVerdict"
      ]
    }
  }
}
